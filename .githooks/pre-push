#!/bin/sh
# The free automatic check for Commerce Lab (owner, 24/11/2026: "If it costs money, we don't need it"). Git runs this
# file by itself before every `git push`, on this PC: no cloud, no GitHub minutes, no Claude usage.
#
# A push to main is a publish (Vercel publishes from GitHub), so it runs `npm test` first (engines, calculators, tax,
# every lesson: a few seconds, needs nothing installed) and is refused if a test fails.
#
# Skipped, because nothing here can break the site:
#   - a push to any other branch (the check belongs at main's door);
#   - a push whose changes are notes only: the files in SAFE below, which no test reads and no page loads.
#
# Not checked here: the phone layout (tools/render-check.mjs needs Apache and Chrome, and a person to look at the
# screenshots). That is `start`, number 4.
#
# Switched on once per copy of the project:  git config core.hooksPath .githooks
# To push without it (only on the owner's yes, and say so):  git push --no-verify
# To see what it would do without running the check:  HOOK_DRY=1 sh .githooks/pre-push < <the push lines>

SAFE='^(\.claude/|\.githooks/|\.gitattributes$|[^/]*\.md$|docs/)'
ZERO=0000000000000000000000000000000000000000

need=""
pushed=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue                      # deleting a branch: nothing to check
  if [ "$remote_sha" = "$ZERO" ]; then changed=$(git ls-tree -r --name-only "$local_sha")
  else changed=$(git diff --name-only "$remote_sha" "$local_sha"); fi
  other=$(printf '%s\n' "$changed" | grep -v -E "$SAFE" | grep -c .)
  if [ "$other" = "0" ]; then
    echo "pre-push: notes only ($(printf '%s\n' "$changed" | grep -c .) files): no check needed."
    continue
  fi
  need=1; pushed=$local_sha
  echo "pre-push: $other changed file(s) can affect the site, for example: $(printf '%s\n' "$changed" | grep -v -E "$SAFE" | head -3 | tr '\n' ' ')"
done

[ -z "$need" ] && exit 0

# The check tests the files in this folder, so they must be exactly what is being pushed.
if [ "$(git rev-parse HEAD)" != "$pushed" ]; then
  echo "pre-push: REFUSED. This folder is not on the commit being pushed to main, so the check would test other files."
  echo "          Push main from a folder that is on that commit."
  exit 1
fi
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: REFUSED. There are unsaved changes in this folder, so the check would not test what is being pushed."
  echo "          Commit them or set them aside first."
  exit 1
fi

if [ -n "$HOOK_DRY" ]; then echo "pre-push: (dry run) would now run: npm test"; exit 0; fi

echo "pre-push: this push publishes the site. Running npm test first ..."
if npm test; then
  echo "pre-push: the tests passed. Pushing. (The phone layout is not checked here: start, number 4.)"
  exit 0
fi
echo "pre-push: REFUSED. A test failed, so main was not pushed and nothing was published. Fix it and push again."
exit 1
